{
  "name": "redline-commander-server",
  "version": "0.2.0",
  "description": "Authoritative match server for Redline Commander",
  "private": true,
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/src/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test build/test/*.test.js",
    "sync:data": "bash ../tools/sync-shared-data.sh",
    "verify:data": "bash ../tools/sync-shared-data.sh --check",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
